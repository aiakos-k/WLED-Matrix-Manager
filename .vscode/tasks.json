{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HA-Stack starten (zentral)",
      "type": "shell",
      "command": "bash ../../scripts/ha-stack.sh up",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Add-on installieren (zentral)",
      "type": "shell",
      "command": "bash ../../scripts/ha-stack.sh apps install local_${input:appName}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Add-on neu bauen und starten (zentral)",
      "type": "shell",
      "command": "bash ../../scripts/ha-stack.sh apps rebuild local_${input:appName} && bash ../../scripts/ha-stack.sh apps start local_${input:appName}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "runOptions": {
        "reevaluateOnRerun": false
      }
    },
    {
      "label": "Add-on-Logs (zentral)",
      "type": "shell",
      "command": "bash ../../scripts/ha-stack.sh logs local_${input:appName}",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: venv anlegen",
      "type": "shell",
      "command": "python3 -m venv venv && ./venv/bin/pip install -r requirements.txt -r requirements-dev.txt",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/backend"
      },
      "detail": "Erstellt wled_matrix_manager/backend/venv mit den gepinnten Abhängigkeiten",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Server starten (dev)",
      "type": "shell",
      "command": "./venv/bin/python -m uvicorn main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/backend"
      },
      "detail": "FastAPI auf http://localhost:8000/docs",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        }
      }
    },
    {
      "label": "Backend: Lint (ruff)",
      "type": "shell",
      "command": "./venv/bin/python -m ruff check .",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Format (ruff)",
      "type": "shell",
      "command": "./venv/bin/python -m ruff format .",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Dependencies (npm ci)",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Dev-Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/frontend"
      },
      "detail": "Vite auf http://localhost:3000",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        }
      }
    },
    {
      "label": "Frontend: Lint (biome)",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Type-Check (tsc)",
      "type": "shell",
      "command": "npm run type-check",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/wled_matrix_manager/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "appName",
      "type": "pickString",
      "description": "Add-on (Slug ohne 'local_')",
      "options": [
        "wled_matrix_manager"
      ]
    }
  ]
}
