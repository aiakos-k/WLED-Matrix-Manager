#!/bin/bash
# DevContainer Bootstrap Script for Home Assistant Add-on Development

set -e

echo "🏠 Initializing Home Assistant Development Container..."

# Mark workspace as safe for git (ownership differs in DevContainer)
git config --global --add safe.directory /mnt/supervisor/addons/local 2>/dev/null || true
for dir in /mnt/supervisor/addons/local/*/; do
  git config --global --add safe.directory "$dir" 2>/dev/null || true
done

# Ensure /run/supervisor is a directory (fix for Home Assistant Core mount)
if [ -f /run/supervisor ]; then
  rm -f /run/supervisor
fi
mkdir -p /run/supervisor

# Create dummy apparmor_parser (not available in DevContainer)
if ! command -v apparmor_parser &> /dev/null; then
  printf '#!/bin/bash\nexit 0\n' > /usr/local/bin/apparmor_parser
  chmod +x /usr/local/bin/apparmor_parser
fi

# Check if Python is available
if ! command -v python3 &> /dev/null; then
  echo "⚠️  Python3 not found in PATH. Trying to locate..."
  if [ -f "/usr/local/bin/python3" ]; then
    export PATH="/usr/local/bin:$PATH"
  fi
fi

# Hash helper (used to detect changed dependency files)
hash_file() {
  if command -v sha256sum &> /dev/null; then
    sha256sum "$1" | cut -d" " -f1
  else
    shasum -a 256 "$1" | cut -d" " -f1
  fi
}

# Install uv - Home Assistant Core uses uv for its development environment
# (see https://www.home-assistant.io/development/ - "Install Python with uv")
if ! command -v uv &> /dev/null; then
  echo "📦 Installing uv..."
  if command -v curl &> /dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | sh > /dev/null 2>&1 || true
  elif command -v wget &> /dev/null; then
    wget -qO- https://astral.sh/uv/install.sh | sh > /dev/null 2>&1 || true
  fi
  export PATH="$HOME/.local/bin:$PATH"
  grep -q ".local/bin" "$HOME/.bashrc" 2>/dev/null || echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
fi
if ! command -v uv &> /dev/null; then
  echo "⚠️  uv is not available - falling back to pip/setuptools"
fi

# Install backend dependencies if Python is available
if command -v python3 &> /dev/null; then
  cd wled_matrix_manager/backend
  # The add-on image (ghcr.io/home-assistant/*-base:3.20) ships Python 3.12.
  # The dev container has to use the same version, otherwise the local
  # environment drifts away from what runs in production.
  PY_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
  REQ_HASH="$(hash_file requirements.txt)"

  VENV_PY_VERSION=""
  if [ -x venv/bin/python ] && venv/bin/python -c "import sys" > /dev/null 2>&1; then
    VENV_PY_VERSION="$(venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo "")"
  fi

  if [ "$VENV_PY_VERSION" != "$PY_VERSION" ]; then
    echo "📦 Creating backend venv (Python $PY_VERSION)..."
    rm -rf venv
    if command -v uv &> /dev/null; then
      uv venv --python "$PY_VERSION" --system-site-packages venv || python3 -m venv venv --system-site-packages
    else
      python3 -m venv venv --system-site-packages
    fi
  fi

  # Reinstall whenever requirements.txt changes - otherwise the venv silently
  # keeps the versions it was created with.
  STAMP="venv/.deps-stamp"
  if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$REQ_HASH|$PY_VERSION" ]; then
    echo "📦 Installing backend dependencies..."
    if command -v uv &> /dev/null; then
      uv pip install --python venv/bin/python -r requirements.txt \
        || venv/bin/python -m pip install -r requirements.txt
    else
      venv/bin/python -m pip install -U pip setuptools wheel
      venv/bin/python -m pip install -r requirements.txt
    fi
    echo "$REQ_HASH|$PY_VERSION" > "$STAMP"
  fi
  cd ../..
fi

# Install frontend dependencies
if command -v npm &> /dev/null; then
  cd wled_matrix_manager/frontend
  LOCK_HASH="$(hash_file package-lock.json)"
  STAMP="node_modules/.deps-stamp"
  if [ ! -d node_modules ] || [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$LOCK_HASH" ]; then
    echo "📦 Installing frontend dependencies..."
    npm ci
    echo "$LOCK_HASH" > "$STAMP"
  fi
  cd ../..
fi

# Install Claude Code CLI
if command -v npm &> /dev/null && ! command -v claude &> /dev/null; then
  echo "🤖 Installing Claude Code CLI..."
  npm install -g @anthropic-ai/claude-code
fi

# Install pi coding agent CLI (requires Node >= 22.19)
# Preferred: managed install mounted from the host (~/.pi), fallback: npm
if [ -x "$HOME/.pi/agent/bin/pi" ]; then
  echo "🤖 Using pi from ~/.pi/agent/bin"
  export PATH="$HOME/.pi/agent/bin:$PATH"
  grep -q "pi/agent/bin" "$HOME/.bashrc" 2>/dev/null || echo 'export PATH="$HOME/.pi/agent/bin:$PATH"' >> "$HOME/.bashrc"
elif command -v npm &> /dev/null; then
  echo "🤖 Installing pi coding agent..."
  npm install -g @earendil-works/pi-coding-agent
fi

# Try to start Home Assistant Supervisor if Docker is available
if command -v docker &> /dev/null; then
  echo "🚀 Starting Home Assistant Supervisor..."
  if timeout 10 ha supervisor start > /tmp/ha_supervisor.log 2>&1 &
  then
    HA_PID=$!
    sleep 3
    if ps -p $HA_PID > /dev/null 2>&1; then
      echo "✅ Home Assistant Supervisor started (PID: $HA_PID)"
    fi
  fi
fi

# Apply DevContainer-specific patches to Supervisor
# These are needed because the DevContainer lacks systemd, dbus, os-agent
patch_supervisor() {
  local max_retries=30
  local i=0
  # Wait for supervisor container to be running
  while [ $i -lt $max_retries ]; do
    if docker inspect hassio_supervisor &>/dev/null 2>&1; then
      break
    fi
    sleep 2
    i=$((i + 1))
  done

  if ! docker inspect hassio_supervisor &>/dev/null 2>&1; then
    echo "⚠️  Supervisor container not found, skipping patches"
    return
  fi

  echo "🔧 Applying DevContainer patches to Supervisor..."

  # Patch 1: Skip gateway firewall check (requires systemd/dbus)
  # Replaces the whole method body with a stub — robust across supervisor versions
  docker exec hassio_supervisor python3 -c "
path = '/usr/src/supervisor/supervisor/host/firewall.py'
with open(path, 'r') as f:
    lines = f.readlines()

new_lines = []
skip_until_next_method = False
for line in lines:
    if skip_until_next_method:
        if line.startswith('    async def ') or line.startswith('    def '):
            skip_until_next_method = False
            new_lines.append(line)
        continue

    if 'async def apply_gateway_firewall_rules' in line:
        new_lines.append(line)
        new_lines.append('        \"\"\"Apply gateway firewall rules - skipped in DevContainer.\"\"\"\n')
        new_lines.append('        return\n')
        skip_until_next_method = True
    else:
        new_lines.append(line)

with open(path, 'w') as f:
    f.writelines(new_lines)
print('patched')
" 2>/dev/null && echo "  ✅ Firewall patch applied" || echo "  ⚠️  Firewall patch skipped"

  # Patch 2: Skip dbus agent call for diagnostics (requires os-agent)
  docker exec hassio_supervisor python3 -c "
path = '/usr/src/supervisor/supervisor/api/supervisor.py'
with open(path, 'r') as f:
    content = f.read()
old = '        if ATTR_DIAGNOSTICS in body:\n            self.sys_config.diagnostics = body[ATTR_DIAGNOSTICS]\n            await self.sys_dbus.agent.set_diagnostics(body[ATTR_DIAGNOSTICS])\n\n            if body[ATTR_DIAGNOSTICS]:\n                init_sentry(self.coresys)\n            else:\n                close_sentry()'
new = '        if ATTR_DIAGNOSTICS in body:\n            self.sys_config.diagnostics = body[ATTR_DIAGNOSTICS]\n            try:\n                await self.sys_dbus.agent.set_diagnostics(body[ATTR_DIAGNOSTICS])\n            except Exception:\n                pass\n\n            if body[ATTR_DIAGNOSTICS]:\n                init_sentry(self.coresys)\n            else:\n                close_sentry()'
if old in content:
    with open(path, 'w') as f:
        f.write(content.replace(old, new))
    print('patched')
elif 'except Exception' in content and 'set_diagnostics' in content:
    print('already patched')
else:
    print('pattern not found')
" 2>/dev/null && echo "  ✅ Diagnostics patch applied" || echo "  ⚠️  Diagnostics patch skipped"

  # Copy apparmor_parser into supervisor container
  docker cp /usr/local/bin/apparmor_parser hassio_supervisor:/usr/sbin/apparmor_parser 2>/dev/null || true

  # Restart supervisor container to apply patches.
  # IMPORTANT: Use "docker restart" (preserves file changes in the container).
  # NEVER use "ha supervisor restart" (recreates container from image = patches lost)!
  # NEVER use "pkill" (cascading failure kills Docker daemon)!
  echo "  🔄 Restarting Supervisor container to apply patches..."
  docker restart hassio_supervisor 2>/dev/null || true
  sleep 15
}

# Monitor supervisor container and re-apply patches after restarts/updates
monitor_supervisor() {
  patch_supervisor
  # Watch for supervisor container recreations
  while true; do
    docker events --filter "container=hassio_supervisor" --filter "event=start" --format "{{.Status}}" 2>/dev/null | while read -r _; do
      echo "🔄 Supervisor container restarted, re-applying patches in 15s..."
      sleep 15
      patch_supervisor
    done
    sleep 30
  done
}

# Run monitor in background so bootstrap completes quickly
monitor_supervisor &

echo ""
echo "✅ DevContainer initialized!"
echo ""
echo "Useful commands:"
echo "  ./patch_supervisor.sh                                 - Re-patch Supervisor after restart"
echo "  ha apps rebuild --force local_wled_matrix_manager    - Rebuild add-on from local Dockerfile"
echo "  ha apps start local_wled_matrix_manager              - Start add-on"
echo "  docker logs --follow addon_local_wled_matrix_manager - View add-on logs"
echo ""

